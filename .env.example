# =============================================================================
# Provenant — umbrella env template
#
# Each sub-package (contracts/, backend/, frontend/) has its own .env.example
# with the *specific* variables it consumes. This file is a master reference.
#
# NEVER commit a real .env / .env.local — they are gitignored.
# Load secrets from your shell, a secret manager, or per-package .env files.
# =============================================================================

# ---- 0G Aristotle mainnet (chain id 16661) ----
OG_RPC_URL=https://evmrpc.0g.ai
OG_CHAIN_ID=16661
OG_EXPLORER_URL=https://chainscan.0g.ai
OG_STORAGE_INDEXER_URL=        # Get from docs.0g.ai
OG_SEALED_INFERENCE_URL=       # Get from docs.0g.ai
OG_SEALED_INFERENCE_API_KEY=   # If applicable

# ---- Sepolia (Ethereum testnet, for the ProvenantReader mirror) ----
SEPOLIA_RPC_URL=               # e.g. https://sepolia.drpc.org or Alchemy/Infura
SEPOLIA_CHAIN_ID=11155111

# ---- Deployer wallet (NEVER commit the real key) ----
PRIVATE_KEY=                   # 0x... hex without 0x prefix accepted by Hardhat

# ---- Deployed contract addresses (filled in after deployment) ----
PROVENANT_CONTRACT_ADDRESS=
PROVENANT_READER_ADDRESS=

# ---- TEE attestation signer address (the public key of the Sealed Inference enclave) ----
TEE_ATTESTATION_SIGNER=        # Set after first Sealed Inference call

# ---- Backend ----
BACKEND_PORT=8787
BACKEND_CORS_ORIGIN=http://localhost:3000

# ---- MEV / commit-reveal wrapper (backend/src/mev/shutter.ts) ----
# 32-byte hex (with or without 0x prefix). Production: replace with Shutter Network's
# `eon_key` from `POST /register_identity`. If unset, the wrapper derives a deterministic
# scaffold seed and logs a warning — DO NOT rely on this in production.
SHUTTER_EON_SEED=

# ---- Indexer (@provenant/indexer — standalone JSON-RPC + REST + WebSocket service) ----
INDEXER_PORT=8788
INDEXER_CORS_ORIGIN=*
INDEXER_DB_PATH=./data/provenant-indexer.db
INDEXER_POLL_INTERVAL_MS=15000
# Optional historical backfill — leave blank to start from current head.
INDEXER_BACKFILL_FROM_BLOCK=
# Optional comma-separated mirror targets: chainId:rpc:reader:pk
# (e.g. 11155111:https://sepolia.drpc.org:0xReader...:0xPrivKey...)
# Off by default. Use only with the TEE-attested signature mode (KelpDAO anti-pattern: never
# re-sign with an indexer-held key; the relayer ships with that fallback off by default).
INDEXER_MIRROR_TARGETS=

# ---- Frontend (Next.js NEXT_PUBLIC_ prefix means it ships to the browser — keep secret-free) ----
NEXT_PUBLIC_BACKEND_URL=http://localhost:8787
# Set this to point the audit page's "Indexer (JSON-RPC)" source toggle at a running indexer.
NEXT_PUBLIC_INDEXER_URL=http://localhost:8788
# Optional: ephemeral X25519 public key of the Sealed Inference enclave for NICE-7 encrypted intents.
NEXT_PUBLIC_ENCLAVE_X25519_PUBLIC_KEY=
NEXT_PUBLIC_PROVENANT_ADDRESS=
NEXT_PUBLIC_PROVENANT_READER_ADDRESS=
NEXT_PUBLIC_TEE_ATTESTATION_SIGNER=
NEXT_PUBLIC_OG_RPC_URL=https://evmrpc.0g.ai
NEXT_PUBLIC_OG_EXPLORER_URL=https://chainscan.0g.ai
NEXT_PUBLIC_SEPOLIA_EXPLORER_URL=https://sepolia.etherscan.io
