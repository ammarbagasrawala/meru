# =============================================================================
# Meru / Provenant — backend/.env.example   ⚠️ TEMPLATE — NOT THE REAL FILE
#
# THIS IS A TEMPLATE. The real secrets live in `.env` (gitignored).
#
# ⛔️ DO NOT run `cp .env.example .env` — it will WIPE your real keys.
#    Instead: open `.env` in your editor, fill the gaps. Use this file as
#    a reference. The `__REPLACE_ME__` poison pill below is intentional
#    so that an accidental `cp` causes the backend to refuse to start
#    with a loud error instead of silently running with placeholder keys.
#
# Vars are grouped by which Level needs them. Levels:
#   Level 0 — local stub mode (no creds needed)
#   Level 1 — Sepolia mirror live
#   Level 2 — 0G Aristotle mainnet contract deployed
#   Level 3 — 0G Storage + Sealed Inference wired
#
# Used by: backend/src/config.ts (Zod-validated at server start).
# =============================================================================

# Poison-pill guard. Backend refuses to start if this is set, ensuring an
# accidental `cp .env.example .env` fails loudly instead of silently using
# placeholder values. Remove this single line in your real .env.
__MERU_TEMPLATE_GUARD__=__do_not_copy_example_over_env__


# ---------------------------------------------------------------------------
# Level 0 — server basics (defaults work; override only if a port clashes)
# ---------------------------------------------------------------------------
# What:    Port the Express server listens on. Frontend's NEXT_PUBLIC_BACKEND_URL
#          must match.
BACKEND_PORT=8787

# What:    CORS allow-list for the frontend origin. Single origin only.
BACKEND_CORS_ORIGIN=http://localhost:3000

# What:    pino log level. "info" in dev; "warn" in prod-like runs.
LOG_LEVEL=info


# ---------------------------------------------------------------------------
# Level 1 — Sepolia (for mirror writes from backend → ProvenantReader)
# ---------------------------------------------------------------------------
# What:    HTTPS JSON-RPC for Sepolia (chainId 11155111). The backend uses this
#          to broadcast `mirror()` calls from `src/mirror/sepolia.ts`.
#
# Where:   Same value as contracts/.env SEPOLIA_RPC_URL — Alchemy / Infura /
#          drpc.org / rpc.sepolia.org.
#
# Format:  Full https URL. The API key (if present) is a bearer credential.
#
SEPOLIA_RPC_URL=

# What:    Deployed ProvenantReader.sol address on Sepolia.
# Where:   The address printed by `contracts/$ npm run deploy:reader` (Level 1).
# Format:  0x-prefixed 40-char hex.
PROVENANT_READER_ADDRESS=


# ---------------------------------------------------------------------------
# Level 2 — 0G Aristotle mainnet (for anchor writes + iNFT mint)
# ---------------------------------------------------------------------------
# What:    HTTPS JSON-RPC for 0G Aristotle (chainId 16661).
# Default: public endpoint; override only if you have a dedicated provider.
OG_RPC_URL=https://evmrpc.0g.ai

# What:    Chain id of 0G Aristotle. Should not change.
OG_CHAIN_ID=16661

# What:    Deployed Provenant.sol address on 0G Aristotle.
# Where:   The address printed by `contracts/$ npm run deploy:provenant`.
# Format:  0x-prefixed 40-char hex.
PROVENANT_CONTRACT_ADDRESS=

# What:    Server wallet private key. Pays gas for `mint`, `logInference`,
#          `commitInference`, `revealAndLogInference`, and Sepolia `mirror` txs.
#          Keep funded with a small amount of OG (Aristotle) and Sepolia ETH.
#
# Where:   Same wallet you used for `contracts/.env::PRIVATE_KEY` is fine; or
#          a dedicated "Provenant Server" account. Export the private key from
#          MetaMask → Account details → Show private key.
#
# Format:  64 hex chars, with or without 0x prefix.
#
# Safety:  Never paste in chat. Never commit. Pre-fund only what you need.
#
SERVER_PRIVATE_KEY=


# ---------------------------------------------------------------------------
# Level 3 — 0G Storage + Sealed Inference (flips ogIntegrationReady() to true)
# ---------------------------------------------------------------------------
# What:    0G Storage Indexer HTTPS endpoint. Backend uploads ciphertext blobs
#          via this URL and gets back a `rootHash` (the CID).
#
# Where:   docs.0g.ai → Storage → Indexer endpoints. Likely shape:
#          https://storage-indexer.0g.ai or a region-specific subdomain.
#
# Format:  Full https URL.
OG_STORAGE_INDEXER_URL=

# What:    0G Sealed Inference API URL. The backend posts encrypted prompts
#          here and receives a TEE-signed bundle (answer + chunk hashes + sig).
#
# Where:   docs.0g.ai → Compute → Sealed Inference.
#
# Format:  Full https URL.
OG_SEALED_INFERENCE_URL=

# What:    0G Sealed Inference API key (bearer credential).
# Where:   0G dashboard once you have an account.
# Format:  Opaque string, ≥ 10 chars.
# Safety:  Never paste in chat. Never commit. Rotate per 0G's recommendation.
OG_SEALED_INFERENCE_API_KEY=

# What:    Public address of the 0G Sealed Inference enclave's attestation key.
#          Used to verify the signature on every bundle the enclave returns.
#
# Where:   Production: extracted from the first attestation response (recover
#          the signer's address from the signature; same value the contract
#          checks against). Level 1 placeholder: use your deployer wallet's
#          public address — you'll redeploy ProvenantReader once you have the
#          real value.
#
# Format:  0x-prefixed 40-char hex.
TEE_ATTESTATION_SIGNER=

# What:    Master AEAD key for HKDF-derived per-corpus encryption keys. The
#          backend uses this to derive each corpus's AES-256-GCM key.
#
# Where:   Generate ONE per environment, locally, with:
#            openssl rand -hex 32
#
# Format:  Exactly 64 hex chars (no 0x prefix; that's what the regex expects).
#
# Safety:  THIS IS THE MOST SENSITIVE VALUE IN THIS FILE. Anyone with this key
#          can decrypt every corpus stored on 0G. Never share. Never commit.
#          Back up offline. If exposed, rotate immediately and re-encrypt all
#          corpora.
ENCRYPTION_MASTER_KEY=


# ---------------------------------------------------------------------------
# Level 3 (optional) — Shutter commit-reveal wrapper
# ---------------------------------------------------------------------------
# What:    The `eonPublicKey` seed used by the Shutter-style commit-reveal
#          scaffold in `src/mev/shutter.ts`. Production: the value returned by
#          `POST /register_identity` against Shutter's keyper API.
#
# Where:   Shutter keyper API (Gnosis) once you wire production keypers; for
#          the in-repo scaffold you can leave this blank — the code will derive
#          a deterministic fallback seed AND log a warning. Do not rely on the
#          fallback in production.
#
# Format:  64 hex chars, with or without 0x prefix.
SHUTTER_EON_SEED=


# =============================================================================
# Quick reference: what to do next
# =============================================================================
# Level 0:    Defaults above work. Just `npm run dev`.
# Level 1:    Fill SEPOLIA_RPC_URL + PROVENANT_READER_ADDRESS + SERVER_PRIVATE_KEY.
# Level 2:    Add PROVENANT_CONTRACT_ADDRESS (after deploying on Aristotle).
# Level 3:    Fill OG_STORAGE_INDEXER_URL, OG_SEALED_INFERENCE_URL/_API_KEY,
#             TEE_ATTESTATION_SIGNER, ENCRYPTION_MASTER_KEY. Restart server.
#             Optional: SHUTTER_EON_SEED for production commit-reveal.
#
# Smoke-test after each step: curl http://localhost:8787/health → should show
# { ok: true, integrations: { ogMainnet: <bool>, sepoliaMirror: <bool> } }.
# =============================================================================
