{
  "name": "@provenant/backend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "description": "Provenant backend — orchestrates 0G Storage upload, Sealed Inference, Chain anchoring, Sepolia mirroring.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "tsx scripts/mainnet-smoke.ts"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "dependencies": {
    "@0gfoundation/0g-compute-ts-sdk": "^0.8.3",
    "@0glabs/0g-ts-sdk": "0.3.1",
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "ethers": "6.13.1",
    "express": "4.21.1",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "multer": "1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pino": "9.5.0",
    "pino-pretty": "11.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/multer": "1.4.12",
    "@types/node": "20.14.10",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "4.19.2",
    "typescript": "5.5.4"
  }
}
