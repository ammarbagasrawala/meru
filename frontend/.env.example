# =============================================================================
# Provenant — frontend/.env.example
#
# This file IS committed (`.env.example` is whitelisted in root .gitignore).
# It is the canonical template — never put real values here.
#
# To populate locally:
#   cp .env.example .env.local       (the real file; gitignored)
#   then edit .env.local with your actual values.
#
# Important: Next.js inlines every NEXT_PUBLIC_* value into the **browser bundle**
# at build time. Anything you put here SHIPS TO USERS. Treat all values as public.
#
#   ✅ OK here: chain IDs, public RPC URLs (no API key), deployed contract addresses,
#               explorer URLs, the enclave's public X25519 key, the TEE signer ADDRESS.
#
#   ❌ NEVER here: private keys, API keys with rate-limit costs, an Alchemy URL
#               that includes your API key (use the public 0G RPC or a
#               separately-scoped public-friendly RPC).
#
# Vars are grouped by which Level needs them:
#   Level 0 — defaults match the local dev setup
#   Level 1 — Sepolia mirror address visible in UI (TrustStrip + Audit page)
#   Level 2 — 0G Provenant address visible in UI (TrustStrip verified-contract chip)
#   Level 3 — Enclave public key for NICE-7 encrypted-intent toggle
#
# Loaded by: Next.js automatically (priority: .env.local > .env.development > .env)
# =============================================================================


# ---------------------------------------------------------------------------
# Level 0 — local-dev service endpoints (override only if ports differ)
# ---------------------------------------------------------------------------
# What:    URL where the frontend reaches the Provenant backend. Must match
#          BACKEND_PORT and BACKEND_CORS_ORIGIN in backend/.env.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8787

# What:    URL where the frontend reaches the audit-log indexer's JSON-RPC.
#          Used by the "Indexer (JSON-RPC)" source toggle on the audit page.
#          Blank disables the toggle.
NEXT_PUBLIC_INDEXER_URL=http://localhost:8788


# ---------------------------------------------------------------------------
# Level 0 — chain metadata for wallet integration + explorer links
# ---------------------------------------------------------------------------
# What:    0G Aristotle public RPC URL. Used by wagmi when the user's wallet
#          adds 0G via the network-mismatch banner's switchChain. **Do NOT put
#          an Alchemy URL with your API key here** — this ships to the browser.
NEXT_PUBLIC_OG_RPC_URL=https://evmrpc.0g.ai

# What:    Chain id of 0G Aristotle.
NEXT_PUBLIC_OG_CHAIN_ID=16661

# What:    Block explorer URL for 0G Aristotle. Used to construct tx + address
#          links in HashChips, the TrustStrip verified-contract chip, etc.
NEXT_PUBLIC_OG_EXPLORER_URL=https://chainscan.0g.ai

# What:    Block explorer URL for Sepolia. Used to construct the Sepolia-mirror
#          tx links shown next to each provenance bundle.
NEXT_PUBLIC_SEPOLIA_EXPLORER_URL=https://sepolia.etherscan.io


# ---------------------------------------------------------------------------
# Level 1 — Sepolia mirror address
# ---------------------------------------------------------------------------
# What:    Deployed ProvenantReader.sol address on Sepolia. Frontend doesn't
#          read from it directly today — it's set for completeness and for
#          future v2 features that link back to the reader's explorer page.
# Where:   The address printed by `contracts/$ npm run deploy:reader`.
# Format:  0x-prefixed 40-char hex. Leave blank in stub mode.
NEXT_PUBLIC_PROVENANT_READER_ADDRESS=


# ---------------------------------------------------------------------------
# Level 2 — 0G Provenant contract address
# ---------------------------------------------------------------------------
# What:    Deployed Provenant.sol address on 0G Aristotle. The TrustStrip's
#          "Verified contract" chip renders ONLY when this is set to a valid
#          0x-address — clicking it opens the contract on Chainscan.
# Where:   The address printed by `contracts/$ npm run deploy:provenant`.
# Format:  0x-prefixed 40-char hex. Leave blank in stub mode.
NEXT_PUBLIC_PROVENANT_ADDRESS=


# ---------------------------------------------------------------------------
# Level 3 — TEE attestation signer address (public)
# ---------------------------------------------------------------------------
# What:    Public address of the 0G Sealed Inference enclave's attestation key.
#          Used by `frontend/src/app/page.tsx` when minting a corpus iNFT to
#          pre-fill the teeAttestationSigner on the upload payload.
# Where:   Same value as backend/.env::TEE_ATTESTATION_SIGNER.
# Format:  0x-prefixed 40-char hex.
NEXT_PUBLIC_TEE_ATTESTATION_SIGNER=


# ---------------------------------------------------------------------------
# Level 3 (optional) — Enclave X25519 public key for NICE-7 encrypted intents
# ---------------------------------------------------------------------------
# What:    The X25519 public key of the 0G Sealed Inference enclave. If set,
#          the Composer's "Keep my question private from the server" toggle
#          becomes active and the frontend encrypts the prompt in-browser
#          before it hits any server. If unset, the toggle is greyed out.
# Where:   docs.0g.ai → Sealed Inference → enclave public-key endpoint.
# Format:  0x-prefixed 64-char hex (32-byte X25519 public key).
NEXT_PUBLIC_ENCLAVE_X25519_PUBLIC_KEY=


# =============================================================================
# Quick reference: what to do next
# =============================================================================
# 1. cp .env.example .env.local
# 2. Level 0:    Defaults above work; `npm run dev` and visit http://localhost:3000.
# 3. Level 1:    Set NEXT_PUBLIC_PROVENANT_READER_ADDRESS after Sepolia deploy.
# 4. Level 2:    Set NEXT_PUBLIC_PROVENANT_ADDRESS after 0G Aristotle deploy
#                → TrustStrip "Verified contract" chip starts rendering.
# 5. Level 3:    Set NEXT_PUBLIC_TEE_ATTESTATION_SIGNER and optionally
#                NEXT_PUBLIC_ENCLAVE_X25519_PUBLIC_KEY for encrypted intents.
# =============================================================================
