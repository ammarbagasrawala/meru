# =============================================================================
# Provenant — contracts/.env.example
#
# This file IS committed (`.env.example` is whitelisted in root .gitignore).
# It is the canonical template — never put real values here.
#
# To populate locally:
#   cp .env.example .env       (the real file; gitignored)
#   then edit .env with your actual values.
#
# Each variable below explains WHAT it is, WHERE to get it, and the FORMAT
# expected.
#
# Used by:
#   hardhat.config.ts           (network configs)
#   scripts/deploy-reader.ts    (Sepolia ProvenantReader deploy)
#   scripts/deploy-provenant.ts (0G Aristotle Provenant deploy)
# =============================================================================


# ---------------------------------------------------------------------------
# PRIVATE_KEY  ·  required for any deploy or contract write
# ---------------------------------------------------------------------------
# What:    The deployer wallet's 32-byte hex private key. This wallet signs
#          every deploy transaction and pays the gas.
#
# Where:   Open MetaMask (or Rabby/Frame/etc.) → create a brand-new account
#          named "Provenant Deploy" → account menu → "Account details" →
#          "Show private key" → copy.
#
#          DO NOT reuse a wallet that holds mainnet funds. This key sits in a
#          plaintext file on your laptop; treat it like one-time-use credentials.
#
# Format:  64 hex chars, with or without 0x prefix. Examples:
#            0xabc123...                  (64 hex after 0x — total 66 chars)
#            abc123...                    (64 hex)
#
# Safety:  Never paste in chat. Never commit. If you accidentally do, transfer
#          remaining ETH out and abandon the address.
#
PRIVATE_KEY=


# ---------------------------------------------------------------------------
# SEPOLIA_RPC_URL  ·  required for Level 1 (ProvenantReader deploy)
# ---------------------------------------------------------------------------
# What:    HTTPS JSON-RPC endpoint for Sepolia (Ethereum testnet, chainId 11155111).
#          Hardhat uses this to broadcast the deploy transaction.
#
# Where:   Either:
#            (a) Alchemy dashboard's "Endpoint URL" for a Sepolia app
#                (https://eth-sepolia.g.alchemy.com/v2/<YOUR_API_KEY>)
#            (b) Any free public RPC like https://sepolia.drpc.org or
#                https://rpc.sepolia.org (slower, rate-limited, but free)
#
# Format:  Full https URL. The API key (if Alchemy/Infura) is part of the URL.
#          The key is a bearer credential — treat as a secret.
#
# Safety:  Lower-stakes than PRIVATE_KEY (rate-limit token, can't drain funds),
#          but still gitignore'd. If exposed, regenerate in your provider's
#          dashboard — costs nothing.
#
SEPOLIA_RPC_URL=


# ---------------------------------------------------------------------------
# TEE_ATTESTATION_SIGNER  ·  required for ProvenantReader deploy
# ---------------------------------------------------------------------------
# What:    The public address (Ethereum-style 0x...) of the 0G Sealed Inference
#          enclave's attestation key. Bound immutably into ProvenantReader at
#          deploy time — it's the only signer the reader will accept mirrored
#          bundles from.
#
# Where:   Two paths:
#
#          PRODUCTION (Level 3+): captured from the first 0G Sealed Inference
#          attestation response. The signed bundle includes a signature; you
#          recover the signer's address from that signature once.
#
#          NOW (Level 1 placeholder): use your DEPLOYER WALLET'S PUBLIC ADDRESS.
#          This makes the reader functional for the cross-chain demo path and
#          lets you exercise the deploy flow today. You will REDEPLOY once the
#          real enclave signer is available — that's expected.
#
# Format:  0x-prefixed 40-char hex (20-byte EVM address).
#
TEE_ATTESTATION_SIGNER=


# ---------------------------------------------------------------------------
# OG_RPC_URL  ·  not used for Level 1; needed for Level 2 (Aristotle mainnet deploy)
# ---------------------------------------------------------------------------
# What:    HTTPS JSON-RPC endpoint for 0G Aristotle mainnet (chainId 16661).
# Default: the public endpoint. Override only if you have a dedicated provider.
# Where:   https://docs.0g.ai → Networks → Aristotle mainnet
#
OG_RPC_URL=https://evmrpc.0g.ai


# ---------------------------------------------------------------------------
# GALILEO_RPC_URL  ·  0G Galileo TESTNET (free OG via faucet)
# ---------------------------------------------------------------------------
# What:    HTTPS JSON-RPC endpoint for 0G Galileo testnet (chainId 16602).
# Default: the public testnet endpoint.
# Where:   https://faucet.0g.ai (0.1 OG/day) or Google Cloud Web3 Faucet.
#
# Why we have this: 0G team (Discord, 14 May 2026) advised building + testing
# entirely on Galileo first, then deploying a single instance to Aristotle
# mainnet at final submission stage. Galileo is free + fast; Aristotle deploy
# is the eligibility-critical artefact that costs ~0.005 native OG.
#
# Deploy command: `npm run deploy:provenant:galileo`
#
GALILEO_RPC_URL=https://evmrpc-testnet.0g.ai


# ---------------------------------------------------------------------------
# Filled-in AFTER deploy (don't touch yet)
# ---------------------------------------------------------------------------
# These get populated once each contract is live. Used by `verify:provenant`
# and by integration tests that need to talk to deployed contracts.

PROVENANT_CONTRACT_ADDRESS=       # set after `npm run deploy:provenant` (Level 2)
PROVENANT_READER_ADDRESS=         # set after `npm run deploy:reader`    (Level 1)


# =============================================================================
# Quick reference: what to do next
# =============================================================================
# 1. cp .env.example .env  (then edit the real file, not this template)
# 2. Fill in PRIVATE_KEY, SEPOLIA_RPC_URL, TEE_ATTESTATION_SIGNER.
# 3. Faucet 0.05 Sepolia ETH to the deployer address:
#       https://www.alchemy.com/faucets/ethereum-sepolia
#       https://sepoliafaucet.com
# 4. Verify balance: https://sepolia.etherscan.io/address/<your-address>
# 5. From contracts/, run:
#       npm run deploy:reader
# =============================================================================
