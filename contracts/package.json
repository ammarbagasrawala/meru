    "chai": "4.5.0",
    "dotenv": "16.4.5",
    "ethers": "^6.14.0",
    "hardhat": "^2.28.0",
    "ts-node": "10.9.2",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2"
  }
