{
  "name": "@provenant/indexer",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "description": "Provenant Audit-Log Indexer — listens to InferenceLogged events on 0G Aristotle and re-publishes them via JSON-RPC + WebSocket. Anyone can run this; multiple chains and indexers can consume one truth source. Track-5 cross-chain-fragmentation primitive.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "dependencies": {
    "better-sqlite3": "11.3.0",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "ethers": "6.13.1",
    "express": "4.21.1",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "pino": "9.5.0",
    "pino-pretty": "11.3.0",
    "ws": "8.18.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.11",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.14.10",
    "@types/ws": "8.5.13",
    "tsx": "4.19.2",
    "typescript": "5.5.4"
  }
}
