# =============================================================================
# Provenant — indexer/.env.example
#
# This file IS committed (`.env.example` is whitelisted in root .gitignore).
# It is the canonical template — never put real values here.
#
# To populate locally:
#   cp .env.example .env       (the real file; gitignored)
#   then edit .env with your actual values.
#
# What this service does: polls 0G Aristotle for `InferenceLogged` and
# `CorpusMinted` events from the deployed Provenant.sol, normalises them into
# SQLite, and exposes JSON-RPC 2.0 + REST + WebSocket APIs. Permissionless —
# anyone can run an instance. Trust flows through the TEE-attested signature
# on each bundle, NOT through the indexer operator.
#
# Vars are grouped by which Level needs them:
#   Level 0 — local stub mode (defaults work; no real events to index)
#   Level 1 — Sepolia (only matters if you set INDEXER_MIRROR_TARGETS)
#   Level 2 — 0G Aristotle Provenant address (the source of truth to index)
#
# Used by: indexer/src/config.ts (Zod-validated at service start).
# =============================================================================


# ---------------------------------------------------------------------------
# Level 0/2 — source chain (where Provenant.sol lives)
# ---------------------------------------------------------------------------
# What:    HTTPS JSON-RPC for 0G Aristotle (chainId 16661). The poller calls
#          eth_getLogs against this endpoint on every tick.
# Default: 0G's public endpoint.
# Where:   docs.0g.ai → Networks → Aristotle mainnet. Override only if you
#          have a dedicated provider (better rate limits).
PROVENANT_CHAIN_RPC=https://evmrpc.0g.ai

# What:    Chain id of 0G Aristotle. Should not change.
PROVENANT_CHAIN_ID=16661

# What:    Deployed Provenant.sol address on 0G Aristotle. **Without this, the
#          indexer starts in REST/RPC-only mode and never polls** — existing
#          DB-cached events stay queryable, but no new events get indexed.
#
# Where:   Set after Level 2 (printed by `contracts/$ npm run deploy:provenant`).
#
# Format:  0x-prefixed 40-char hex.
PROVENANT_CONTRACT_ADDRESS=


# ---------------------------------------------------------------------------
# Level 0 — indexer service basics
# ---------------------------------------------------------------------------
# What:    Port the indexer HTTP/WS server listens on. Frontend's
#          NEXT_PUBLIC_INDEXER_URL must match.
INDEXER_PORT=8788

# What:    CORS allow-list. "*" is fine for local dev / public indexer; a
#          single origin is safer for production deployments.
INDEXER_CORS_ORIGIN=*

# What:    Path to the SQLite database file (relative to indexer/). Auto-created.
INDEXER_DB_PATH=./data/provenant-indexer.db

# What:    How often the poller hits the RPC, in ms. 15s is a good default;
#          shorter = fresher data + more RPC calls (rate-limit risk).
INDEXER_POLL_INTERVAL_MS=15000

# What:    Optional. The block number to start backfilling from. Blank = start
#          from current head. Set this if you want to capture events that fired
#          before the indexer first started.
INDEXER_BACKFILL_FROM_BLOCK=

# What:    Log level. "info" in dev; "warn" in production-like runs.
LOG_LEVEL=info


# ---------------------------------------------------------------------------
# Level 1 (optional) — multi-chain mirror relayer
# ---------------------------------------------------------------------------
# What:    Comma-separated list of `<chainId>:<rpcUrl>:<readerAddress>:<privateKey>`
#          tuples. Each destination is mirrored independently; failure on one
#          doesn't block others.
#
# Example: 11155111:https://sepolia.drpc.org:0xReader...:0xPrivKey...
#
# CRITICAL: the default mode RE-PUBLISHES the TEE-attested signature already
# on the bundle. It does NOT re-sign with an indexer-held key. Re-signing
# would re-introduce the KelpDAO anti-pattern (a single privileged signing
# key becomes the cross-chain trust root; KelpDAO paid ~$2M for that mistake
# in 2024). See `src/relayer.ts` for the explicit guard around the
# `indexerSignFallback` fallback mode.
#
# Off by default. Leave blank unless you've read the warning in src/relayer.ts.
INDEXER_MIRROR_TARGETS=


# =============================================================================
# Quick reference: what to do next
# =============================================================================
# Level 0:    Defaults above work. `npm run dev` → service listens on 8788 in
#             REST/RPC-only mode (no polling until PROVENANT_CONTRACT_ADDRESS
#             is set).
# Level 2:    Set PROVENANT_CONTRACT_ADDRESS. Restart. Indexer begins polling.
# Optional:   Set INDEXER_MIRROR_TARGETS if you want this indexer to relay
#             events to ProvenantReader.sol on other chains.
#
# Smoke-test: curl http://localhost:8788/health
#   → { ok: true, lastIndexedBlock: <n>, chainId: 16661 }
# =============================================================================
